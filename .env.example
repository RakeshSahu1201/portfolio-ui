# Client-side contact endpoint
VITE_CONTACT_API_URL=/api/contact

# Server-side Resend configuration for Vercel Function
RESEND_API_URL=https://api.resend.com/emails
RESEND_API_KEY=
RESEND_FROM_EMAIL=Portfolio <onboarding@resend.dev>
CONTACT_TO_EMAIL=

# Server-side PostgreSQL connection for Vercel Functions
# (This is automatically populated in Vercel if using the Neon integration).
# Example: postgres://username:password@ep-xxxxx.us-east-2.aws.neon.tech/neondb
DATABASE_URL=
